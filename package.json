  "version": "1.0.0",
  "description": "A food tracker for every cuisine — katori, roti and grams alike. Offline-first PWA + Android app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
